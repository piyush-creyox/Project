<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="split_sale_wiz_form" model="ir.ui.view">
        <field name="name">split.sale.wiz.form</field>
        <field name="model">split.sale.wiz</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>

                        <button
                            name="process_button"
                            type="object"
                            string="Process"
                            class="btn-primary"/>

                        <button
                            special="cancel"
                            string="Cancel"
                            class="btn-primary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>