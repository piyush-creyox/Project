<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_student_student_form" model="ir.ui.view">
        <field name="name">Form view Student Table (Model)</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <button name="action_write_student"
                            string="Write Student"
                            type="object"/>
                    <button name="action_search_student"
                            string="Search Student"
                            type="object"/>
                    <button name="action_unlink_student"
                            string="Delete Student"
                            type="object"/>
                    <button name="action_browse_student"
                            string="Browse student"
                            type="object"/>
                    <button name="action_read_student"
                            string="Read Student"
                            type="object"/>
                    <group>
                        <field name="name"/>
                        <field name="image" widget="image"/>
                        <field name="street"/>
                        <field name="city"/>
                        <field name="zip"/>
                        <field name="state_id"/>
                        <field name="country_id"/>
                        <field name="birthdate"/>
                        <field name="age"/>
                        <field name="mobile" widget="phone"/>
                        <field name="email" widget="email"/>
                        <field name="barcode"/>
                        <field name="department_id"/>
                        <field name="dept_code"/>
                        <field name="type" widget="radio"/>
                        <field name="notes"/>
                        <field name="remarks"/>
                        <field name="is_cr" widget="boolean_toggle"/>
                        <field name="cr_start_date" invisible="not is_cr" required="is_cr"/>
                        <field name="cr_end_date" invisible="not is_cr" required="is_cr"/>
                        <field name="no_of_votes" invisible="not is_cr" required="is_cr"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_student_student_list" model="ir.ui.view">
        <field name="name">List view Student Table (Model)</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list>

                <field name="name"/>
                <field name="image" widget="image"/>
                <field name="street"/>
                <field name="city"/>
                <field name="zip"/>
                <field name="state_id"/>
                <field name="country_id"/>
                <field name="birthdate"/>
                <field name="age"/>
                <field name="mobile" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="barcode"/>
                <field name="department_id"/>
                <field name="dept_code"/>
                <field name="type" widget="radio"/>
                <field name="notes"/>
                <field name="remarks"/>
                <field name="is_cr" widget="boolean_toggle"/>
                <field name="cr_start_date" invisible="not is_cr" required="is_cr"/>
                <field name="cr_end_date" invisible="not is_cr" required="is_cr"/>
                <field name="no_of_votes" invisible="not is_cr" required="is_cr"/>
                <field name="active" widget="boolean_toggle"/>

            </list>
        </field>
    </record>

    <record id="view_student_student_kanban" model="ir.ui.view">
        <field name="name">Kanban view Student Table (Model)</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <kanban class="student_view_kanban">
                <field name="name"/>
                <field name="street"/>
                <field name="notes"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div>
                                <field name="name"/>
                            </div>
                            <div>
                                <field name="street"/>
                            </div>
                            <div>
                                <field name="notes"/>
                            </div>
                            <div>
                                <field name="active"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_student_student_activity" model="ir.ui.view">
        <field name="name">student.student.activity</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <activity string="Contracts">
                <field name="name"/>
                <field name="street"/>
                <field name="notes"/>
                <templates>
                    <div t-name="activity-box">
                        <div class="ms-2">
                            <field name="name"/>
                            <field name="street"/>
                            <field name="notes"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="view_student_student_pivot" model="ir.ui.view">
        <field name="name">Pivot view Student Table (Model)</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <pivot string="Activities Analysis" sample="0">
                <field name="street" type="col"/>
                <field name="name" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_student_student_graph" model="ir.ui.view">
        <field name="name">Graph view Student Table (Model)</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <graph string="Invoices Analysis" type="line" sample="1">
                <field name="name"/>
                <field name="no_of_votes"/>
            </graph>
        </field>
    </record>

    <record id="ir_cron_check_students" model="ir.cron">
        <field name="name">Check Students</field>
        <field name="model_id" ref="model_student_student"/>
        <field name="state">code</field>
        <field name="code">model.check_students()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Quotations -->
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">list,form,kanban,activity,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No TikTok quotations found!
            </p>
            <p>
                Quotations from TikTok Shop will appear here.
            </p>
        </field>
    </record>


    <!-- ========================================== -->

    <menuitem id="menu_student_student"
              name="Student" parent="menu_department_management" sequence="5" action="action_student"
              groups="cr_department_management.group_student_user"/>


</odoo>